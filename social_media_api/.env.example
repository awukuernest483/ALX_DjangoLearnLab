# =============================================================================
# Social Media API - Environment Configuration
# =============================================================================
# Copy this file to .env and configure your environment variables.
# NEVER commit .env to version control!
# =============================================================================

# Django Settings
# ---------------
# Generate a new secret key for production:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-super-secret-key-here

# Set to False in production
DEBUG=True

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1,.herokuapp.com,.yourdomain.com

# Database Configuration
# ----------------------
# For PostgreSQL, use a DATABASE_URL like:
# DATABASE_URL=postgres://user:password@host:5432/database_name
# DATABASE_URL=

# CORS Configuration
# ------------------
# Comma-separated list of allowed origins for CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security Settings
# -----------------
# Set to True when using HTTPS in production
SECURE_SSL_REDIRECT=False

# Logging
# -------
DJANGO_LOG_LEVEL=INFO
